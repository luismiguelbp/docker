# ============================================
# Docker & Infrastructure Standard .gitignore
# ============================================

# --- Secrets and Local Config ---
.env
.env.*
!.env.example

# Mosquitto password files
**/passwords_file

# --- Docker Runtime Data & Persistence ---
# We ignore the entire data/ directory which contains all service 
# persistent data, databases, and local configurations.
data/

# Ignore SQLite databases and journals globally
*.db
*.db-journal

# --- Logs ---
*.log
logs/

# --- OS Specific ---
.DS_Store
Thumbs.db
.Spotlight-V100
.Trashes

# --- Editor / IDE ---
.vscode/
.idea/
*.swp
*.swo
.cursor/

# --- Miscellaneous ---
.history/
*.bak
*.tmp
