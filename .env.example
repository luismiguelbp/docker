# ============================================
# DOCKER COMPOSE CONFIGURATION
# ============================================
# Copy this file to .env and customize values
# cp .env.example .env

COMPOSE_PROJECT_NAME=ct
COMPOSE_PATH_SEPARATOR=,

# Add the services you want to run (comma-separated):
# Available: compose-portainer.yml, compose-mosquitto.yml, compose-node-red.yml,
#            compose-grafana.yml, compose-postgresql.yml, compose-sqlite.yml
COMPOSE_FILE=compose.yml,compose-portainer.yml,compose-mosquitto.yml,compose-node-red.yml,compose-grafana.yml,compose-postgresql.yml

# ============================================
# PATHS AND SYSTEM
# ============================================

# Docker base directory (recommended: /opt/docker)
# Service data will be stored in ${DOCKER_PATH}/data/
DOCKER_PATH=/opt/docker

# Timezone (find yours: timedatectl list-timezones)
DOCKER_TZ=Europe/Madrid

# User/Group IDs for container permissions
# Run: echo "UID: $(id -u), GID: $(id -g)" to find your IDs
DOCKER_UID=1000
DOCKER_GID=1000

# ============================================
# MOSQUITTO (MQTT)
# ============================================
# Configure authentication in: ${DOCKER_PATH}/data/mosquitto/config/mosquitto.conf
# See: https://mosquitto.org/documentation/

# ============================================
# NODE-RED
# ============================================
# Configure in: ${DOCKER_PATH}/data/node-red/data/settings.js
# See: https://nodered.org/docs/user-guide/runtime/settings-file

# Credential secret for encrypting flow credentials (passwords, API keys)
# Generate with: openssl rand -hex 32
NODE_RED_CREDENTIAL_SECRET=changeme

# ============================================
# POSTGRESQL
# ============================================

POSTGRES_USER=admin
POSTGRES_PASSWORD=changeme
POSTGRES_DB=homelab

# ============================================
# GRAFANA
# ============================================

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme
GRAFANA_INSTALL_PLUGINS=grafana-clock-panel
